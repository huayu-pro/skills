  "substyles": {
    "A": {
      "name": "档案红黑",
      "themes": [
        "theme-archive",
        "theme-archive-ember",
        "theme-archive-rust"
      ],
      "summary": "三套同语法、不同油墨：正红最锐，焦墨偏暖，锈橙偏沉。红系承载立场，黑提供结构，米白是主动的负空间。",
      "mood": "硬、旧、压得住",
      "use": "文化、品牌、观点型分享、需要档案感的回顾"
    },
    "B": {
      "name": "重墨印刷",
      "themes": [
        "theme-signal",
        "theme-press"
      ],
      "summary": "同一套语法换一种墨。不是极简双色：必须有粗斜带、实心墨块和压得住的面积。靛蓝偏科技，青墨偏报刊档案。",
      "mood": "冷、重、精确",
      "use": "科技产品、数据汇报、工程/设计分享、报刊档案向内容"
    },
    "C": {
      "name": "彩色巨构",
      "themes": [
        "theme-c1",
        "theme-c2",
        "theme-c3",
        "theme-c4",
        "theme-c5",
        "theme-c6",
        "theme-c7"
      ],
      "summary": "保留构成主义的构图骨架，把固定的红黑换成撞色。仍是两墨一纸，不是多彩 UI。",
      "mood": "意外、强烈、有能量",
      "use": "创意提案、活动、宣言、年轻向内容"
    }
  },
