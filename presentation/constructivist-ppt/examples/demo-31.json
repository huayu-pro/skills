    {
      "id": "d01",
      "role": "cover",
      "layout": "L02",
      "claim": "印刷不是中性容器，排版本身就是立场",
      "minutes": 1.5,
      "slots": {
        "masthead": "PRESS WORKS / NO.07",
        "title1": "纸张的声音",
        "subtitle": "从铅字到海报：印刷术如何塑造现代视觉。",
        "counter1": "07",
        "counter2": "12",
        "lead": "一份关于油墨、纸张与目光的简史。图可以没有，结构不能没有。",
        "meta": "PRESS / 1926 — NOW"
      },
      "notes": {
        "purpose": "建立基调：这是一份报纸气质的分享，不是科技发布会",
        "talk": [
          "开场不念标题，让右上角的空窗站两秒",
          "这页刻意没配图——空窗本身就是设计"
        ],
        "transition": "从空窗切到主张",
        "cue": "语气压低，速度放慢。"
      }
    },
    {
      "id": "d02",
      "role": "thesis",
      "layout": "L17",
      "axisDeg": 9,
      "claim": "每一次印刷都是一次取舍，中性排版不存在",
      "minutes": 1,
      "slots": {
        "kicker": "THESIS / 主张",
        "title1": "印刷不是",
        "title2": "中性的",
        "body": "每一次印刷都是一次选择：什么被放大，什么被裁掉，什么压在第一层。所谓中性的排版，只是把选择藏起来了。",
        "stat": "1889",
        "statNote": "LINOTYPE",
        "meta": "THESIS 01"
      },
      "notes": {
        "purpose": "让观众记住：排版的选择本身就是立场",
        "talk": [
          "巨圆是这页唯一的巨物",
          "1889 是铸排机之年，选择的成本从此骤降"
        ],
        "transition": "从主张切到方法",
        "cue": "手指向圆心说那句主张。"
      }
    },
    {
      "id": "d03",
      "role": "method",
      "layout": "L18",
      "claim": "油墨的工序只有三步：定、压、裁",
      "minutes": 1.5,
      "slots": {
        "kicker": "METHOD / 四级台阶",
        "title": "油墨的工序",
        "meta": "ASCENDING"
      },
      "groups": {
        "steps": [
          {
            "num": "01",
            "label": "CLAIM",
            "text": "先定主张与字级。"
          },
          {
            "num": "02",
            "label": "SET",
            "text": "拣字，排成硬线。"
          },
          {
            "num": "03",
            "label": "PRESS",
            "text": "一次压印定型。"
          },
          {
            "num": "04",
            "label": "CROP",
            "text": "裁掉多余，出血。"
          }
        ]
      },
      "notes": {
        "purpose": "让观众带走三步工序，并理解台阶高度就是重要性",
        "talk": [
          "台阶从左到右爬升",
          "最后一级最高，因为裁切决定最终面貌"
        ],
        "transition": "从工序切到时间",
        "cue": "顺着台阶从左往右讲。"
      }
    },
    {
      "id": "d04",
      "role": "sequence",
      "layout": "L20",
      "claim": "四个节点把语言变成了视觉",
      "minutes": 1.5,
      "slots": {
        "kicker": "TIMELINE / 脊线",
        "title": "四个节点",
        "lead": "从铸排机到屏幕，印刷把语言一步步变成视觉。"
      },
      "groups": {
        "nodes": [
          {
            "date": "1889",
            "label": "LINOTYPE",
            "text": "铸排机落地。"
          },
          {
            "date": "1919",
            "label": "POSTER",
            "text": "海报成为武器。"
          },
          {
            "date": "1950",
            "label": "GRID",
            "text": "网格接管版面。"
          },
          {
            "date": "2024",
            "label": "SCREEN",
            "text": "纸张移到屏幕。"
          }
        ]
      },
      "notes": {
        "purpose": "让观众记住四个年份各自改变了什么",
        "talk": [
          "节点沿脊线交替上下",
          "起点最重，其余节点递减"
        ],
        "transition": "从时间切到证据",
        "cue": "不要逐个念年份，讲变化。"
      }
    },
